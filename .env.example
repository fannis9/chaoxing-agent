# Copy to .env and configure your provider locally. Never commit .env.
CX_OPENAI_BASE_URL=
CX_ANSWER_MODEL=
CX_ANSWER_API_KEY_ENV=OPENAI_API_KEY
OPENAI_API_KEY=
# responses or chat-completions; select the protocol supported by your provider.
CX_MODEL_PROTOCOL=responses
# Opt in: model judges explicitly unavailable quizzes, records deferred and advances.
CX_AI_SKIP_UNAVAILABLE=0
# Opt in: defer the entire quiz on answer-processing errors and continue chapters.
CX_SKIP_QUIZ_ERRORS=0
# Login-only operation: discover enrolled courses, persist queue and recover.
CX_AUTOMATION=0
# Optional when Page Bridge is detected beside this repository.
# CX_PAGE_BRIDGE=/absolute/path/to/pagebridge/page.mjs
