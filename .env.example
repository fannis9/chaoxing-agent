# 复制为 .env 后在本机填写；不要提交 .env。
# 模型：DeepSeek 用 responses，OpenAI 兼容接口用 chat-completions。
CX_OPENAI_BASE_URL=https://api.deepseek.com
CX_ANSWER_MODEL=deepseek-flash
CX_ANSWER_API_KEY_ENV=DEEPSEEK_API_KEY
DEEPSEEK_API_KEY=
CX_MODEL_PROTOCOL=responses

# 可用性/错误策略：1 = 开启
CX_AI_SKIP_UNAVAILABLE=1
CX_SKIP_QUIZ_ERRORS=1
CX_AUTOMATION=1

# 控制台端口（扩展侧栏里填同一个值）
# CX_CONSOLE_PORT=8788
# 控制器轮询间隔（毫秒），降低浏览器操作频率
CX_QUIZ_POLL_MS=10000
# 视频倍速上限（1 或 2）；平台不允许时会自动退回 1x
CX_MAX_RATE=2
