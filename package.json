{
  "name": "chaoxing-agent",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "学习通任务代理：侧栏控制台 + 自有浏览器扩展驱动已登录标签页，不依赖 Page Bridge。",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "console": "node dev/console.mjs",
    "doctor": "node doctor.mjs",
    "token": "node -e \"process.stdout.write(require('fs').readFileSync('quiz-reports/console-token','utf8').trim()+'\\n')\"",
    "build:scripts": "node dev/build-scripts.mjs",
    "test:agent": "node dev/console-agent-test.mjs",
    "smoke": "node dev/smoke.mjs",
    "test:rules": "node dev/agent-rules-test.mjs",
    "test": "node dev/agent-rules-test.mjs && node dev/command-parse-test.mjs && node dev/course-run-test.mjs && node dev/platform-test.mjs && node dev/popup-test.mjs && node dev/console-agent-test.mjs",
    "test:parse": "node dev/command-parse-test.mjs",
    "test:platform": "node dev/platform-test.mjs",
    "test:popup": "node dev/popup-test.mjs"
  },
  "dependencies": {
    "playwright-core": "^1.65.1"
  }
}
