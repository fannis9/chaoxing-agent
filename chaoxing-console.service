[Unit]
Description=Chaoxing side panel controller
After=graphical-session.target

[Service]
Type=simple
# Use npm run service:files to generate definitions with this machine's paths.
WorkingDirectory=/absolute/path/to/chaoxing-pagebridge-controller
ExecStart=/absolute/path/to/node /absolute/path/to/chaoxing-pagebridge-controller/dev/console.mjs
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
