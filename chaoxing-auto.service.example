[Unit]
Description=Chaoxing PageBridge automatic study controller
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/ABSOLUTE/PATH/TO/chaoxing-pagebridge
ExecStart=/ABSOLUTE/PATH/TO/node --env-file=/ABSOLUTE/PATH/TO/chaoxing-pagebridge/.env /ABSOLUTE/PATH/TO/chaoxing-pagebridge/chaoxing-auto.mjs
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
