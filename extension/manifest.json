{
  "manifest_version": 3,
  "name": "学习通任务控制台",
  "version": "0.1.0",
  "description": "在学习通页面显示当前任务状态与日志。",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel", "tabs", "scripting"],
  "host_permissions": ["https://chaoxing.com/*", "https://*.chaoxing.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "打开学习通控制台"},
  "content_scripts": [{
    "matches": ["https://chaoxing.com/*", "https://*.chaoxing.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
